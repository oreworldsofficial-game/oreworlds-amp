Meta.DisplayName=Oreworlds
Meta.Description=Oreworlds dedicated server (Linux): the packaged game run headless, an always-on host for one world
Meta.OS=Linux
Meta.AarchSupport=x86_64
Meta.Author=Oreworlds
Meta.ConfigManifest=oreworldsconfig.json
Meta.MetaConfigManifest=oreworldsmetaconfig.json
Meta.ConfigRoot=oreworlds.kvp
Meta.MinAMPVersion=2.4.6.0
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.DockerBaseReadOnlyFS=False
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.EndpointURIFormat=
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.URL=
App.DisplayName=Oreworlds
App.RootDir=./oreworlds/
App.BaseDirectory=./oreworlds/
App.ExecutableWin=
App.ExecutableLinux=Oreworlds/Binaries/Linux/FactoryGame-Linux-Shipping
App.WorkingDir=
App.LinuxCommandLineArgs=
App.CommandLineArgs=Oreworlds -nullrhi -nosound -unattended -nosplash -NoVerifyGC -userdir="{{$FullBaseDir}}ServerData" -FGServer -FGPort={{$GamePort}} -FGMaxPlayers={{MaxPlayers}} -FGServerName="{{ServerName}}" -FGSaveMinutes={{SaveMinutes}} -FGServerWorld="{{ServerWorld}}" -FGSeed="{{Seed}}" {{NewWorld}} {{Sandbox}}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=60
App.ExitString=stop
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ApplicationIPBinding=0.0.0.0
App.ApplicationPort1=29472
App.ApplicationPort2=0
App.ApplicationPort3=0
App.AdminPortRef=
App.PrimaryApplicationPortRef=GamePort
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.RapidStartup=False
App.UseLinuxIOREDIR=False
App.ForceIPBinding=False
App.EnvironmentVariables={}
App.Ports=@IncludeJson[oreworldsports.json]
App.UpdateSources=@IncludeJson[oreworldsupdates.json]
App.MaxUsers=7
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.SteamWorkshopDownloadLocation=
App.RequiredFiles=[]
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(?!\[Server\] ).*$
Console.AppReadyRegex=^\[Server\] ready: .*$
Console.UserJoinRegex=^\[Server\] (?<username>.+?) joined$
Console.UserLeaveRegex=^\[Server\] (?<username>.+?) left \(.*\)$
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.MetricsRegex=^\[Server\] players: (?<UsersOnline>\d+) of (?<MaxUsers>\d+).*$
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.SleepMessage=
Limits.WakeOnRequestFrom=0.0.0.0
