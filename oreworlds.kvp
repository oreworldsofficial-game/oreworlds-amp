App.DisplayName=Oreworlds
App.RootDir=./oreworlds/
App.BaseDirectory=./oreworlds/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=Oreworlds/Binaries/Linux/FactoryGame-Linux-Shipping
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=Oreworlds -nullrhi -nosound -unattended -nosplash -NoVerifyGC -userdir="{{$FullBaseDir}}ServerData" -FGServer -FGPort={{$ApplicationPort1}} -FGMaxPlayers={{$MaxUsers}} -FGServerName="{{ServerName}}" -FGSaveMinutes={{SaveMinutes}} {{NewWorld}} {{Sandbox}} {{JoinCode}} -FGPreset={{Preset}} -FGIronFrequency={{IronFrequency}} -FGIronSize={{IronSize}} -FGIronRichness={{IronRichness}} -FGCopperFrequency={{CopperFrequency}} -FGCopperSize={{CopperSize}} -FGCopperRichness={{CopperRichness}} -FGCoalFrequency={{CoalFrequency}} -FGCoalSize={{CoalSize}} -FGCoalRichness={{CoalRichness}} -FGStoneFrequency={{StoneFrequency}} -FGStoneSize={{StoneSize}} -FGStoneRichness={{StoneRichness}} -FGOilFrequency={{OilFrequency}} -FGOilSize={{OilSize}} -FGOilRichness={{OilRichness}} -FGLeadFrequency={{LeadFrequency}} -FGLeadSize={{LeadSize}} -FGLeadRichness={{LeadRichness}} -FGToxicStoneFrequency={{ToxicStoneFrequency}} -FGToxicStoneSize={{ToxicStoneSize}} -FGToxicStoneRichness={{ToxicStoneRichness}} -FGUraniumFrequency={{UraniumFrequency}} -FGUraniumSize={{UraniumSize}} -FGUraniumRichness={{UraniumRichness}} -FGVentsFrequency={{VentsFrequency}} -FGVentsSize={{VentsSize}} -FGSeeps={{Seeps}} -FGSpires={{Spires}} -FGBlooms={{Blooms}} -FGLakes={{Lakes}} -FGLakeSize={{LakeSize}} -FGRockyShores={{RockyShores}} -FGLakeNearStart={{LakeNearStart}} -FGHills={{Hills}} -FGMountains={{Mountains}} -FGTrees={{Trees}} -FGRocks={{Rocks}} -FGFrozenLands={{FrozenLands}} -FGBiomeSize={{BiomeSize}} -FGStartArea={{StartArea}} -FGServerNoDamage={{ServerNoDamage}} -FGSeed={{Seed}} -FGPassword="{{Password}}" -FGServerWorld={{ServerWorld}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=60
App.ExitString=stop
App.ExitFile=
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=True
App.ApplicationIPBinding=0.0.0.0
